{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoyStudio Desktop",
  "version": "2.0.1",
  "identifier": "dev.roylang.studio",
  "build": {
    "beforeDevCommand": "node serve.mjs",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "RoyStudio Desktop — RoyLang IDE",
        "width": 1440,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "fileAssociations": [
      { "ext": ["roy", "roylang"], "name": "RoyLang Source", "description": "Исходный файл RoyLang", "role": "Editor" },
      { "ext": ["royson"], "name": "RoySON Data", "description": "Файл данных RoySON", "role": "Editor" },
      { "ext": ["royproj"], "name": "RoyLang Project", "description": "Проект RoyLang", "role": "Editor" },
      { "ext": ["royscene"], "name": "RoyLang Scene", "description": "Сцена и уровень RoyLang", "role": "Editor" },
      { "ext": ["royprefab"], "name": "RoyLang Prefab", "description": "Префаб сущности RoyLang", "role": "Editor" },
      { "ext": ["royanim"], "name": "RoyLang Animation", "description": "Таймлайн-анимация RoyLang", "role": "Editor" },
      { "ext": ["roymodel"], "name": "RoyLang Model", "description": "ИИ/ML-модель RoyLang", "role": "Editor" },
      { "ext": ["roydata"], "name": "RoyLang Dataset", "description": "Датасет ML/SFT RoyLang", "role": "Editor" }
    ],
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/runners/roy-runner-win-x64.exe"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "basicUi"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1RDg0QUNDMDk1QjkwRTUKUldUbGtGc0p6RXJZdGVjZGpNektWbFRZbnlqa2NFL2F6UGpRQktQaFhNdnpTNUtodmlwZlNSQ3gK",
      "endpoints": [
        "https://github.com/RoyWals/RoyStudioDesktop/releases/latest/download/latest.json"
      ]
    }
  }
}